<?xml version="1.0" encoding="utf-8"?>
<dialect name='HEAVY.AI'
         class='heavyai_jdbc'
         base='DefaultSQLDialect'
         version='18.1'>
   <function-map>
     <function group='operator' name='-' return-type='date'>
       <formula>DATEDIFF(&apos;day&apos;, %1, %2)</formula>
       <argument type='date' />
       <argument type='date' />
     </function>
     <function group='operator' name='-' return-type='datetime'>
       <formula>TIMESTAMPDIFF(&apos;second&apos;, %1, %2)</formula>
       <argument type='datetime' />
       <argument type='datetime' />
     </function>
