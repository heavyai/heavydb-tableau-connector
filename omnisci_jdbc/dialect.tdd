       <formula>TIMESTAMPDIFF(&apos;second&apos;, %1, %2)</formula>
       <argument type='datetime' />
       <argument type='date' />
     </function>
     <function group='string' name='CONTAINS' return-type='bool'>
       <formula>%1 LIKE %2</formula>
       <argument type='str' />
       <argument type='str' />
     </function>
    <function group='aggregate' name='APPROX_COUNTD' return-type='int'>
      <formula>APPROX_COUNT_DISTINCT(%1)</formula>
      <unagg-formula>(CASE WHEN %1 THEN 1 WHEN NOT %1 THEN 1 ELSE 0 END)</unagg-formula>
      <argument type='bool' />
    </function>
    <function group='aggregate' name='APPROX_COUNTD' return-type='int'>
      <formula>APPROX_COUNT_DISTINCT(%1)</formula>
      <unagg-formula>(CASE WHEN (%1 IS NULL) THEN 0 ELSE 1 END)</unagg-formula>
      <argument type='real' />
    </function>
