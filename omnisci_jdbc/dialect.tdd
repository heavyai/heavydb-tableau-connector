      <formula part='day'>DATEDIFF(&apos;day&apos;,%2,%3)</formula>
      <formula part='weekday'>DATEDIFF(&apos;weekday&apos;,%2,%3)</formula>
      <formula part='week'>DATEDIFF(&apos;week&apos;,%2,%3)</formula>
